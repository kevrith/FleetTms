{
  "expo": {
    "name": "FleetTms",
    "slug": "fleettms",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    },
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kastra.fleettms",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1220"
      },
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kastra.fleettms",
      "buildNumber": "1"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "FleetTms uses the camera to photograph the odometer, cargo and any faults."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FleetTms stamps each photo with where it was taken, and shows your employer where the lorry is during a trip.",
          "locationAlwaysAndWhenInUsePermission": "FleetTms shares the lorry's position with your employer while a trip is running, including with the screen off. It stops when you end the trip.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "51cbb482-04fa-45fc-8b8d-3f6fcd834364"
      }
    },
    "owner": "kevrith"
  }
}
