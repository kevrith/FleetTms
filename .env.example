# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=fleettms
POSTGRES_PASSWORD=
POSTGRES_DB=fleettms
POSTGRES_PORT=5442
REDIS_PORT=6379
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
API_PORT=8010
CORS_ORIGINS=http://localhost:5180

# Auth
JWT_SECRET=
ENVIRONMENT=development
# For: python -m app.cli create-platform-admin
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=
# For: python -m app.cli seed-demo
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# Photo storage (development): folder for private photos. Leave empty to use apps/api/media_store.
MEDIA_DIR=

# Scheduled reports (leave empty in development; reports then go to an in-memory outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REPORT_TEMPLATE=

# M-Pesa Daraja client payments (leave the keys empty in development; a stand-in is used)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# The public address Safaricom calls back on, for example https://api.your-domain.example
PUBLIC_API_URL=

# KRA eTIMS (leave empty in development; a stand-in is used). Sandbox: see KRA's eTIMS OSCU documentation.
ETIMS_BASE_URL=
