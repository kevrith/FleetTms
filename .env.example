# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=fleettms
POSTGRES_PASSWORD=
POSTGRES_DB=fleettms
POSTGRES_PORT=5442
REDIS_PORT=6379
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
API_PORT=8010
CORS_ORIGINS=http://localhost:5180

# Auth
JWT_SECRET=
ENVIRONMENT=development
# For: python -m app.cli create-platform-admin
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=
# For: python -m app.cli seed-demo
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# Photo storage (development): folder for private photos. Leave empty to use apps/api/media_store.
MEDIA_DIR=

# Scheduled reports (leave empty in development; reports then go to an in-memory outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REPORT_TEMPLATE=

# M-Pesa Daraja client payments (leave the keys empty in development; a stand-in is used)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# The public address Safaricom calls back on, for example https://api.your-domain.example
PUBLIC_API_URL=

# KRA eTIMS (leave empty in development; a stand-in is used). Sandbox: see KRA's eTIMS OSCU documentation.
ETIMS_BASE_URL=
# The address of the web app, for client tracking links (default http://localhost:5180)
PUBLIC_WEB_URL=

# GPS trackers through Traccar (leave empty in development)
# Traccar forwards device data to the API at /hooks/traccar/<TRACCAR_FORWARD_KEY>. Make the key a long random string.
TRACCAR_FORWARD_KEY=
# Used to send the remote engine stop through Traccar: its address and an API token from its settings.
TRACCAR_URL=
TRACCAR_TOKEN=

# Route suggestions (Google Maps Routes API) and the monthly EPRA pump price feed. Leave empty in development: an estimate and typed-in prices are used.
GOOGLE_MAPS_API_KEY=
# A JSON feed of EPRA's monthly pump prices: {"month": "2026-10-01", "prices": [{"region": "Nairobi", "diesel": 191.45, "petrol": 205.2}]} (KES per litre).
EPRA_PRICES_URL=

# Document reading: a cloud vision model reads photographed receipts, weighbridge tickets, delivery notes, insurance certificates and
# logbooks, and a person confirms what it read. Leave the key empty to switch reading off. The photo is sent to the provider.
ANTHROPIC_API_KEY=
DOCUMENT_READER_MODEL=

# Subscriptions: the platform's own M-Pesa Paybill and Lipa na M-Pesa Online passkey (the Daraja consumer key and secret above are used with them).
# Leave empty in development: a stand-in is used and nothing leaves the machine.
PLATFORM_SHORTCODE=
PLATFORM_PASSKEY=
# Plan limits and read-only mode. Set both to false to give every account every feature while developing.
ENFORCE_PLANS=true
ENFORCE_BILLING=true

# Security. ENVIRONMENT=production makes the API refuse to start with development settings (see apps/api/app/http_security.py): a JWT_SECRET
# under 32 characters, CORS_ORIGINS that are not the real https:// addresses, PUBLIC_API_URL not https, plan limits or billing or rate limits
# switched off, the test stand-ins for AI, or text messages still going to the in-memory stand-in.
RATE_LIMITS_ENABLED=true
# Set to true only when a proxy you control sets X-Forwarded-For; otherwise anyone could invent their own address.
TRUST_PROXY_HEADERS=false

# Retention (masterplan 11.3). The defaults are the policy; change them only with the advocate's agreement.
PHOTO_RETENTION_DAYS=730
FORMER_STAFF_RETENTION_DAYS=1826
CANCELLED_GRACE_DAYS=90
FINANCIAL_RETENTION_DAYS=1826
# How many days a person's data protection request may stay open (to be confirmed with the advocate).
DSAR_DUE_DAYS=30

# Backups and monitoring (docs/disaster-recovery.md). BACKUP_DIR is the folder that holds base/ and wal/; leave it empty on machines that do
# not make backups. The uptime checker (python -m app.uptime_check) emails ALERT_EMAILS using the SMTP settings above, and/or posts to ALERT_WEBHOOK_URL.
BACKUP_DIR=
ALERT_EMAILS=
ALERT_WEBHOOK_URL=

# Text messages through Africa's Talking (sign-in codes, reminders, alerts). Leave the username and key empty in development: messages then stay
# in memory, and a production deployment refuses to start without them. AT_SANDBOX=true uses their test environment.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false

# Partner programme (proposals, not agreements): the share a new partner starts on, and for how many months after a business's first payment it
# is earned (0 means for as long as the business pays). WEB_APP_URL is the web app's address, for the link texted to a new partner.
PARTNER_COMMISSION_PCT=20
PARTNER_COMMISSION_MONTHS=24
WEB_APP_URL=

# Help and support shown in the apps and on the help pages. Leave empty until the channels exist.
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_HOURS=Monday to Saturday, 8am to 6pm (Nairobi time)

# Counts of which parts of the product each business uses (no people, no content). Set to false to switch it off.
ANALYTICS_ENABLED=true
