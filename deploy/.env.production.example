# Production settings. Copy to deploy/.env.production and fill in. NEVER commit the filled-in file (it is git-ignored).
# Passwords and keys: make them long and random (for example `openssl rand -hex 32`); use letters and digits only so they are safe in addresses.

# --- where it runs ---
# the web app, for example app.example.com
APP_HOST=
# the API, for example api.example.com
API_HOST=
# https:// plus API_HOST
API_ORIGIN=
# the same as API_ORIGIN: the address Safaricom and the trackers call
PUBLIC_API_URL=
# https:// plus APP_HOST
WEB_APP_URL=
# https:// plus APP_HOST (only the web app may call the API from a browser)
CORS_ORIGINS=
# refuses to start with development settings (apps/api/app/http_security.py)
ENVIRONMENT=production

# --- database, queue, backups ---
POSTGRES_USER=fleettms
POSTGRES_PASSWORD=
POSTGRES_DB=fleettms
REDIS_PASSWORD=
# a folder on ANOTHER disk or a mounted bucket, writable by uid 1000 (docs/disaster-recovery.md)
BACKUP_DIR=

# --- photos and data copies ---
# local keeps them in the media volume (backed up by scripts/dr/backup-files.sh). s3 keeps them in a private bucket of any S3-compatible
# provider (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, Backblaze B2): then run once, inside the api container,
#   python -m app.storage_migrate --dry-run     and then     python -m app.storage_migrate --delete-local
# Leave the key and secret empty to use the machine's own role. Never make the bucket public: the API serves the files itself.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false

# --- security ---
# at least 32 random characters; rotating it signs everyone out and changes callback addresses
JWT_SECRET=

# --- text messages (Africa's Talking) ---
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- M-Pesa (clients paying businesses, and businesses paying FleetTms) ---
DARAJA_ENV=production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
PLATFORM_SHORTCODE=
PLATFORM_PASSKEY=

# --- tax, email, AI, maps, trackers ---
ETIMS_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
TRACCAR_FORWARD_KEY=
# Automatic WhatsApp (parts orders, payment reminders): docs/whatsapp.md. The token needs the other three with it.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=
# Card payments (Paystack): the secret key from their dashboard; set the webhook there to https://<your API address>/hooks/paystack
PAYSTACK_SECRET_KEY=
# The platform's own eTIMS device: FleetTms's tax invoices to its customers go to KRA from it
PLATFORM_KRA_PIN=
PLATFORM_ETIMS_BRANCH_ID=00
PLATFORM_ETIMS_DEVICE_SERIAL=
PLATFORM_VAT_PCT=16

# --- support and monitoring ---
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
ALERT_EMAILS=
ALERT_WEBHOOK_URL=
