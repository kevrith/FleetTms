# Production settings. Copy to deploy/.env.production and fill in. NEVER commit the filled-in file (it is git-ignored).
# Passwords and keys: make them long and random (for example `openssl rand -hex 32`); use letters and digits only so they are safe in addresses.

# --- where it runs ---
# the web app, for example app.example.com
APP_HOST=
# the API, for example api.example.com
API_HOST=
# https:// plus API_HOST
API_ORIGIN=
# the same as API_ORIGIN: the address Safaricom and the trackers call
PUBLIC_API_URL=
# https:// plus APP_HOST
WEB_APP_URL=
# https:// plus APP_HOST (only the web app may call the API from a browser)
CORS_ORIGINS=
# refuses to start with development settings (apps/api/app/http_security.py)
ENVIRONMENT=production

# --- database, queue, backups ---
POSTGRES_USER=fleettms
POSTGRES_PASSWORD=
POSTGRES_DB=fleettms
REDIS_PASSWORD=
# a folder on ANOTHER disk or a mounted bucket, writable by uid 1000 (docs/disaster-recovery.md)
BACKUP_DIR=

# --- security ---
# at least 32 random characters; rotating it signs everyone out and changes callback addresses
JWT_SECRET=

# --- text messages (Africa's Talking) ---
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- M-Pesa (clients paying businesses, and businesses paying FleetTms) ---
DARAJA_ENV=production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
PLATFORM_SHORTCODE=
PLATFORM_PASSKEY=

# --- tax, email, AI, maps, trackers ---
ETIMS_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
TRACCAR_FORWARD_KEY=

# --- support and monitoring ---
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
ALERT_EMAILS=
ALERT_WEBHOOK_URL=
