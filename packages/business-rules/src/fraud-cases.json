  "fuel_check": [
    {
      "name": "on target",
      "litres": 305,
      "km": 1000,
      "idle_hours": 0,
      "l_per_km": 0.3,
      "expected": {
        "flagged": false,
        "expected_litres": 300.0,
        "variance_pct": 1.7,
        "severity": null
      }
    },
    {
      "name": "inflated fuel",
      "litres": 345,
      "km": 1000,
      "idle_hours": 0,
      "l_per_km": 0.3,
      "expected": {
        "flagged": true,
        "expected_litres": 300.0,
        "variance_pct": 15.0,
        "severity": "amber"
      }
    },
    {
      "name": "far above is red",
      "litres": 400,
      "km": 1000,
      "idle_hours": 0,
      "l_per_km": 0.3,
      "expected": {
        "flagged": true,
        "expected_litres": 300.0,
        "variance_pct": 33.3,
        "severity": "red"
      }
    },
    {
      "name": "long idling explains extra fuel",
      "litres": 360,
      "km": 1000,
      "idle_hours": 20,
      "l_per_km": 0.3,
      "expected": {
        "flagged": false,
        "expected_litres": 360.0,
        "variance_pct": 0.0,
        "severity": null
      }
    },
    {
      "name": "the same fuel with no idling is flagged",
      "litres": 360,
      "km": 1000,
      "idle_hours": 0,
      "l_per_km": 0.3,
      "expected": {
        "flagged": true,
        "expected_litres": 300.0,
        "variance_pct": 20.0,
        "severity": "amber"
      }
    },
    {
      "name": "short trips are not judged",
      "litres": 90,
      "km": 20,
      "idle_hours": 0,
      "l_per_km": 0.3,
      "expected": {
        "flagged": false,
        "expected_litres": null,
        "variance_pct": null,
        "severity": null
      }
    },
    {
      "name": "exactly at the threshold is not flagged",
      "litres": 330,
      "km": 1000,
      "idle_hours": 0,
      "l_per_km": 0.3,
      "expected": {
        "flagged": false,
        "expected_litres": 300.0,
