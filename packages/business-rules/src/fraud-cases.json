      ]
    },
    {
      "name": "GPS drift of a few metres is still one stop",
      "points": [
        [0, -1.0, 36.0, 0],
        [900, -1.0003, 36.0003, 1],
        [1800, -1.0002, 35.9998, 0],
        [2700, -1.0001, 36.0001, 0]
      ],
      "expected": [
        {
          "start_s": 0.0,
          "end_s": 2700.0,
          "minutes": 45.0,
          "lat": -1.0,
          "lng": 36.0
        }
      ]
    },
    {
      "name": "a single fix is not a stop",
      "points": [
        [0, -1.0, 36.0, 0],
        [60, -0.9, 36.0, 60]
      ],
      "expected": []
    },
    {
      "name": "no speed reported, same place",
      "points": [
        [0, -1.0, 36.0, null],
        [1800, -1.0, 36.0, null]
      ],
      "expected": [
        {
          "start_s": 0.0,
          "end_s": 1800.0,
          "minutes": 30.0,
          "lat": -1.0,
          "lng": 36.0
        }
      ]
    },
    {
      "name": "two stops with driving between",
      "points": [
        [0, -1.0, 36.0, 0],
        [1200, -1.0, 36.0, 0],
        [1260, -0.95, 36.0, 70],
        [1500, -0.9, 36.0, 0],
        [2700, -0.9, 36.0, 0]
      ],
      "expected": [
        {
          "start_s": 0.0,
          "end_s": 1200.0,
          "minutes": 20.0,
          "lat": -1.0,
          "lng": 36.0
        },
        {
          "start_s": 1500.0,
          "end_s": 2700.0,
          "minutes": 20.0,
          "lat": -0.9,
          "lng": 36.0
        }
      ]
    }
